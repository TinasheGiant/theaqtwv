rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCeo() {
      return isSignedIn() && (
        request.auth.token.email == "regimsontina@gmail.com" ||
        request.auth.token.email == "ceo@aqutewave.co.zw" ||
        request.auth.token.email == "tinashe@aqutewave.co.zw" ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "CEO"
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isCeo() ||
        request.auth.token.email == "manager@aqutewave.co.zw" ||
        request.auth.token.email == "editor@aqutewave.co.zw" ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public catalog content (Read and Write for real-time admin synchronization)
    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /software/{softwareId} {
      allow read, write: if true;
    }

    match /portfolio/{portfolioId} {
      allow read, write: if true;
    }

    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Bookings: Public can create, Staff/Admin can manage
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Contact messages: Public can submit, Staff/Admin can manage
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // Invoices & Billing
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Admin Users collection
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // Registered Clients
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // System Settings: Public can read basic config, Admin can write
    match /system_settings/{configId} {
      allow read, write: if true;
    }

    // Audit logs
    match /access_logs/{logId} {
      allow read, write: if true;
    }
  }
}
